{
  "name": "portail-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unofficial editor for the eowave Portail MIDI-to-CV interface. Client-side only, no backend.",
  "scripts": {
    "sync-spec": "node scripts/build-model.mjs",
    "predev": "npm run sync-spec",
    "dev": "vite",
    "prebuild": "npm run sync-spec",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm run sync-spec",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
